# ==========================================================
# CẤU HÌNH PHÍM TẮT WEBSITE LIÊN DƯƠNG (ban-mau-13)
# ==========================================================
# Cách viết phím:
#   - Chữ cái: A..Z (không phân biệt hoa/thường, hoạt động cả khi bật Unikey)
#   - Số: 0..9
#   - Phím đặc biệt: Space, Esc (hoặc Escape), Ctrl (hoặc Control),
#                    ArrowLeft, ArrowRight, ArrowUp, ArrowDown, Tab, Enter, F1..F12
#   - Để trống (ví dụ KEY_NAV_LEFT=) nếu muốn tắt phím tắt đó.

# Chuyển tab ngang trên thanh menu (Trang chủ <-> Văn phòng <-> ... <-> Tài liệu)
KEY_NAV_LEFT=A
KEY_NAV_RIGHT=D

# Chuyển tab dọc cột trái (Mặt bằng <-> Sơ đồ nguyên lý <-> Kịch bản vận hành)
KEY_MUC_UP=W
KEY_MUC_DOWN=S

# Chế độ toàn màn hình (Full Screen)
KEY_FULLSCREEN=Space
KEY_EXIT_FULLSCREEN=Esc

# Tab Mặt bằng: mở/đóng danh sách thiết bị & bỏ bộ lọc
KEY_TOGGLE_DEVICES=Ctrl
KEY_CLEAR_FILTER=Space

# Chuyển trang bản vẽ trước / sau (và chuyển phím trong Pop-up)
KEY_PAGE_PREV=ArrowLeft
KEY_PAGE_NEXT=ArrowRight

